# Copy this file to .env and enter your local MySQL credentials.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace_with_your_mysql_password
MYSQL_DATABASE=farm_advisory

# Replace this with a long random value before production deployment.
FLASK_SECRET_KEY=replace_with_a_long_random_secret
